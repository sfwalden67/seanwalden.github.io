---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const posts = (await getCollection('howtos')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Layout title="How-tos — Your Name">
  <h1>How-tos</h1>
  <ul class="posts">
    {posts.map((p) => (
      <li>
        <a href={`${base}/howtos/${p.id}`}>{p.data.title}</a>
        <div class="meta">{p.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</div>
        <div>{p.data.description}</div>
      </li>
    ))}
  </ul>
</Layout>
